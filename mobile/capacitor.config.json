{
  "appId": "store.pass50.app",
  "appName": "PASS50",
  "webDir": "www",
  "server": {
    "url": "https://pass50.store",
    "cleartext": false,
    "allowNavigation": [
      "pass50.store",
      "*.pass50.store",
      "www.pass50.store"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#050705",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#050705"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "scheme": "PASS50",
    "limitsNavigationsToAppBoundDomains": true
  }
}
