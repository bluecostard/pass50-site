{
  "expo": {
    "name": "PASS50",
    "slug": "pass50",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pass50",
    "userInterfaceStyle": "dark",
    "description": "Classement, fil, lives et paris sur l'actualité des influenceurs ivoiriens.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "store.pass50.app",
      "buildNumber": "9",
      "associatedDomains": [
        "applinks:pass50.store",
        "applinks:www.pass50.store"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "store.pass50.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#050705",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pass50.store",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "pass50.store",
              "path": "/app.html"
            },
            {
              "scheme": "https",
              "host": "www.pass50.store",
              "pathPrefix": "/app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050705"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBase": "https://pass50.store/api/",
      "eas": {
        "projectId": "5f122043-730b-45d5-bc92-1bb88706bb5e"
      }
    },
    "owner": "bluecostard"
  }
}
