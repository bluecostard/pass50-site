# PASS50 — sécurité + cache UI
# SSL IONOS déjà actif (Sectigo *.pass50.store). Ce fichier force HTTPS.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Les appels HMAC utilisent encore le domaine www dans le secret GitHub.
  # Ne pas rediriger ces endpoints signés : un 301 interromprait le POST avant PHP.
  RewriteCond %{HTTP_HOST} ^www\.pass50\.store$ [NC]
  RewriteCond %{REQUEST_URI} ^/api/(metrics-ranking-publication-simulate-cron|content-freshness-cron-v4|metrics-ranking-cron-v2)\.php$ [NC]
  RewriteRule ^ - [L]

  # Canonique : https://pass50.store (sans www)
  RewriteCond %{HTTP_HOST} ^www\.pass50\.store$ [NC]
  RewriteRule ^ https://pass50.store%{REQUEST_URI} [L,R=301]

  # Proxy / reverse-proxy IONOS
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Accès HTTP direct
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pages FI publiques SEO : /fi/{id}
  RewriteRule ^fi/([A-Za-z0-9][A-Za-z0-9_-]{0,99})/?$ fi.php?id=$1 [L,QSA]

  # Sitemap dynamique (profils FI inclus)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=86400; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always unset X-Powered-By
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https:; worker-src 'self' blob:; upgrade-insecure-requests"
  <FilesMatch "\.(html?|js|css|json|webmanifest)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(php)$">
    Header always set Cache-Control "no-store"
  </FilesMatch>
  <Files "fi.php">
    Header always set Cache-Control "public, max-age=300"
  </Files>
  <Files "sitemap.php">
    Header always set Cache-Control "public, max-age=600"
  </Files>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<FilesMatch "(?i)\.(env|sql|sqlite|bak|old|log|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "(?i)^(install\.php|config\.php|config\.example\.php|composer\.(json|lock)|package(-lock)?\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

RedirectMatch 404 (?i)^/(private|emails|mobile|live-scout-standalone|node_modules)/
DirectoryIndex index.html
